              "path": ["api", "plans"]
            }
          }
        },
        {
          "name": "Editar Plano (admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"nome\": \"Plano Atualizado\", \"ativo\": 1 }"
            },
            "url": {
              "raw": "{{base_url}}/api/plans/1",
              "host": ["{{base_url}}"],
              "path": ["api", "plans", "1"]
            }
          }
        },
        {
          "name": "Deletar Plano (admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/plans/1",
              "host": ["{{base_url}}"],
              "path": ["api", "plans", "1"]
            }
          }
        }
      ]
    }
  ]
}