{
  "info": {
    "name": "Conecta.Net API",
    "description": "Collection completa da API REST do portal Conecta.Net.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api", "type": "string" },
    { "key": "token",       "value": "", "type": "string" },
    { "key": "admin_token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Cliente",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"12345678900\",\n  \"senha\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set('token', data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/admin-login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"00000000000\",\n  \"senha\": \"senha_claudio\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set('admin_token', data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Usuários — Cliente",
      "item": [
        {
          "name": "Cadastrar Cliente",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Silva\",\n  \"cpf\": \"12345678900\",\n  \"telefone\": \"62999990000\",\n  \"cidade\": \"Goiânia\",\n  \"setor\": \"Setor Bueno\",\n  \"cep\": \"74000000\",\n  \"senha\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Meus Dados",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Contratar Plano",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/users/me/plan",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plano_id\": 1\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Planos — Público",
      "item": [
        {
          "name": "Listar Planos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/plans?page=1&limit=10",
              "query": [
                { "key": "page",  "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Planos — Admin",
      "item": [
        {
          "name": "Criar Plano",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/plans",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"100 Mega\",\n  \"velocidade\": \"100 Mbps\",\n  \"preco\": 79.90,\n  \"descricao\": \"Ideal para estudos e redes sociais\"\n}"
            }
          }
        },
        {
          "name": "Editar Plano",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/plans/1",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"100 Mega\",\n  \"velocidade\": \"100 Mbps\",\n  \"preco\": 84.90,\n  \"descricao\": \"Ideal para estudos e redes sociais\"\n}"
            }
          }
        },
        {
          "name": "Excluir Plano",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/plans/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Usuários — Admin",
      "item": [
        {
          "name": "Listar Usuários",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users?page=1&limit=10&cpf=&nome=",
              "query": [
                { "key": "page",  "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "cpf",   "value": "" },
                { "key": "nome",  "value": "" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "Editar Usuário",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/users/1",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Silva Atualizado\",\n  \"telefone\": \"62988880000\",\n  \"cidade\": \"Goiânia\",\n  \"setor\": \"Setor Sul\",\n  \"cep\": \"74000001\"\n}"
            }
          }
        },
        {
          "name": "Editar Plano do Usuário",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/users/1/plan",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plano_id\": 2\n}"
            }
          }
        },
        {
          "name": "Resetar Senha do Usuário",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/users/1/reset-password",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nova_senha\": \"novaSenha123\"\n}"
            }
          }
        },
        {
          "name": "Excluir Usuário",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/users/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        }
      ]
    }
  ]
}
